# AI API Keys - Add at least ONE (multiple FREE options available!)

# Option 1: OpenAI (PAID - requires payment)
OPENAI_API_KEY=your_openai_api_key_here

# Option 2: Anthropic Claude (PAID - requires payment)  
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Option 3: OpenRouter (FREE models available!) - Recommended for free usage
# Get free key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=meta-llama/llama-3.2-3b-instruct:free

# Option 4: Groq (FREE and FAST!) - Highly recommended
# Get free key at: https://console.groq.com/keys  
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# Option 5: HuggingFace (FREE tier available)
# Get free key at: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=your_huggingface_api_key_here
HUGGINGFACE_MODEL=mistralai/Mixtral-8x7B-Instruct-v0.1

# Model Configuration
# Options: openai, anthropic, openrouter, groq, huggingface
DEFAULT_LLM_PROVIDER=groq
DEFAULT_MODEL=llama-3.1-8b-instant

# MCP Configuration
MCP_SERVER_URL=http://localhost:8080
MCP_ENABLED=false

# Application Settings
DEBUG_MODE=false
OUTPUT_DIRECTORY=./output
